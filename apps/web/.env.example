# Claude API (optional: without it the command center runs its local engine)
ANTHROPIC_API_KEY=
JARVIS_CORE_MODEL=claude-sonnet-5-5
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase: without these, JARVIS runs on one device only (local mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used by the scheduled job. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Shared with Supabase Vault (jarvis_cron_secret) so only the scheduler can call /api/cron/tick
CRON_SECRET=
# EVAGD calendar export URL (contains a private token: server only, never in code)
EVAGD_ICAL_URL=
