# Claude API (optional: without it the command center runs its local engine)
ANTHROPIC_API_KEY=
JARVIS_CORE_MODEL=claude-sonnet-5-5
JARVIS_VISION_MODEL=claude-opus-5-5
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase: without these, JARVIS runs on one device only (local mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: lets you call /api/cron/tick by hand. The scheduler uses a token generated inside Postgres.
CRON_SECRET=
# Optional fallback. Normally the EVAGD link is pasted in Ajustes and kept encrypted in Supabase Vault.
EVAGD_ICAL_URL=
